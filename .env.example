# En desarrollo, el API corre en local. En producción vale https://api-memberplus.neyzt.org
# Se lee en runtime: cambiarla no exige reconstruir la imagen.
API_INTERNAL_URL=http://127.0.0.1:8000

# Clave pública de Cloudflare Turnstile para el login. Se lee en runtime (no se hornea en la imagen).
# Vacía = sin widget y el login funciona como siempre. Llave de prueba que siempre pasa: 1x00000000000000000000AA
TURNSTILE_SITEKEY=
